#: lib/phoenix_kit/modules/emails/web/templates.ex:302
#, elixir-autogen, elixir-format
msgid "Activate System Template"
msgstr "Активировать системный шаблон"

#: lib/phoenix_kit/modules/emails/web/templates.ex:304
#, elixir-autogen, elixir-format
msgid "Activating \"%{name}\" makes the database template win again for this email, overriding any file override or built-in default."
msgstr "Активация «%{name}» снова делает приоритетным шаблон из базы данных для этого письма, переопределяя файловый оверрайд или встроенный текст по умолчанию."

#: lib/phoenix_kit/modules/emails/web/templates.ex:277
#, elixir-autogen, elixir-format
msgid "Archive System Template"
msgstr "Архивировать системный шаблон"

#: lib/phoenix_kit/modules/emails/web/templates.ex:707
#, elixir-autogen, elixir-format
msgid "Failed to clone template: %{reason}"
msgstr "Не удалось клонировать шаблон: %{reason}"

#: lib/phoenix_kit/modules/emails/web/templates.ex:475
#, elixir-autogen, elixir-format
msgid "Template '%{name}' activated — the database template now wins for this email again"
msgstr "Шаблон «%{name}» активирован — теперь для этого письма снова используется шаблон из базы данных"

#: lib/phoenix_kit/modules/emails/web/templates.ex:464
#, elixir-autogen, elixir-format
msgid "Template '%{name}' archived — it now falls back to its file override or built-in default"
msgstr "Шаблон «%{name}» архивирован — теперь используется файловый оверрайд или встроенный текст по умолчанию"

#: lib/phoenix_kit/modules/emails/web/template_editor.html.heex:236
#, elixir-autogen, elixir-format
msgid "Use Archive/Activate on the Templates list to change a system template's status — it shows what changes first."
msgstr "Чтобы изменить статус системного шаблона, используйте кнопки «Архивировать»/«Активировать» в списке шаблонов — там сначала показывается, что изменится."

#: lib/phoenix_kit/modules/emails/web/templates.ex:443
#, elixir-autogen, elixir-format
msgid "Archiving \"%{name}\" removes it from the admin test-send lookup — sending a test email will use a built-in English template (with HTML) instead of your saved one. Newsletters campaigns that already reference this template keep using it (they load it by id, not status), but it disappears from the newsletters editor's template picker. You can reactivate it at any time."
msgstr "Архивирование «%{name}» уберёт его из поиска тестовых писем — тестовое письмо отправится по встроенному английскому шаблону (с HTML) вместо сохранённого. Рассылки, уже ссылающиеся на этот шаблон, продолжат его использовать (они загружают его по id, а не по статусу), но он исчезнет из списка выбора в редакторе рассылок. Шаблон можно снова активировать в любой момент."

#: lib/phoenix_kit/modules/emails/web/templates.ex:450
#, elixir-autogen, elixir-format
msgid "Archiving \"%{name}\" stops sending its saved subject, body and translations for this email. It falls back to a file override (if one is configured for this name) or the sending module's built-in text, which may not cover every language you use and has no HTML unless a file override supplies one. You can reactivate it at any time."
msgstr "Архивирование «%{name}» прекращает отправку сохранённых темы, текста и переводов для этого письма. Оно переключится на файловый оверрайд (если настроен для этого имени) или на встроенный текст отправляющего модуля, который может покрывать не все ваши языки и не содержит HTML, если его не добавляет оверрайд. Шаблон можно снова активировать в любой момент."

#: lib/phoenix_kit/modules/emails/web/templates.ex:511
#, elixir-autogen, elixir-format
msgid "Failed to activate template: %{reason}"
msgstr "Не удалось активировать шаблон: %{reason}"

#: lib/phoenix_kit/modules/emails/web/templates.ex:504
#, elixir-autogen, elixir-format
msgid "Failed to archive template: %{reason}"
msgstr "Не удалось архивировать шаблон: %{reason}"

#: lib/phoenix_kit/modules/emails/web/templates.ex:457
#, elixir-autogen, elixir-format
msgid "Template '%{name}' archived — test emails will now use the built-in template instead"
msgstr "Шаблон «%{name}» архивирован — теперь тестовые письма будут отправляться по встроенному шаблону"
