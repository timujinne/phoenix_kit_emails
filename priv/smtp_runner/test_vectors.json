{
  "format": 1,
  "comment": "Shared test vectors of the SMTP runner dialogue. smtp = how the scripted fake server behaves; session (defaults + per-vector probe/mx/settings) = what the site hands out; commands = what the runner must send, in order (never DATA); report = the result entry the runner must report (ms is not compared); classification = what Verification.Classifier makes of it. Used by the ExUnit suite (schema and classifier) and by the Pester suite (the real script).",
  "defaults": {
    "domain": "example.test",
    "mx": [
      "127.0.0.1"
    ],
    "probe": null,
    "settings": {
      "mail_from": "verify@sender.test",
      "helo": "runner.example.test",
      "connect_timeout_s": 2,
      "read_timeout_s": 5
    }
  },
  "vectors": [
    {
      "name": "normal_250",
      "description": "One address accepted: the whole dialogue, QUIT at the end, no DATA.",
      "rcpt": [
        {
          "id": "r1",
          "email": "info@example.test"
        }
      ],
      "smtp": {
        "banner": [
          "220 mx.example.test ESMTP ready"
        ],
        "rules": [
          {
            "match": "^EHLO ",
            "reply": [
              "250 mx.example.test"
            ]
          },
          {
            "match": "^MAIL FROM:",
            "reply": [
              "250 2.1.0 Ok"
            ]
          },
          {
            "match": "^RCPT TO:",
            "reply": [
              "250 2.1.5 Ok"
            ]
          },
          {
            "match": "^QUIT",
            "reply": [
              "221 2.0.0 Bye"
            ],
            "then": "close"
          }
        ]
      },
      "commands": [
        "EHLO runner.example.test",
        "MAIL FROM:<verify@sender.test>",
        "RCPT TO:<info@example.test>",
        "QUIT"
      ],
      "report": {
        "lease": "lease-normal-250",
        "mx_used": "127.0.0.1",
        "outcome": "answered",
        "steps": [
          {
            "cmd": "banner",
            "code": 220,
            "text": "mx.example.test ESMTP ready"
          },
          {
            "cmd": "ehlo",
            "code": 250,
            "text": "mx.example.test"
          },
          {
            "cmd": "mail",
            "code": 250,
            "text": "2.1.0 Ok"
          }
        ],
        "rcpt": [
          {
            "id": "r1",
            "code": 250,
            "text": "2.1.5 Ok"
          }
        ]
      },
      "classification": {
        "verdicts": {
          "r1": {
            "action": "final",
            "status": "valid",
            "reason": "smtp_ok",
            "level": "smtp"
          }
        },
        "domain": {
          "catch_all": null,
          "blocked": false
        },
        "failed": false
      }
    },
